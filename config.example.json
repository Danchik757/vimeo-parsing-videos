{
  "secrets_file": "config.secrets.example.json",
  "vimeo_api": {
    "token": "YOUR_VIMEO_TOKEN",
    "secret": "YOUR_VIMEO_SECRET",
    "client_id": "YOUR_VIMEO_CLIENT_ID"
  },
  "vimeo_login": {
    "email": "YOUR_VIMEO_EMAIL",
    "password": "YOUR_VIMEO_PASSWORD"
  },
  "proxy": {
    "enabled": false,
    "host": "YOUR_PROXY_HOST",
    "port": "3128",
    "username": "YOUR_PROXY_USERNAME",
    "password": "YOUR_PROXY_PASSWORD"
  },
  "files": {
    "source_json": "/absolute/path/to/need_parse_unique.json",
    "videos_dir": "output/run/videos",
    "jsons_dir": "output/run/jsons",
    "logs_dir": "output/run",
    "failed_downloads": "output/run/failed_downloads.json",
    "log_file": "output/run/download.log",
    "summary_file": "output/run/summary.json",
    "results_file": "output/run/results_manifest.json"
  },
  "telegram": {
    "enabled": true,
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
    "chat_id": "YOUR_TELEGRAM_CHAT_ID",
    "api_base_url": "https://api.telegram.org",
    "source_address": "",
    "notify_download_every_n_successes": 0,
    "notify_skip_every_n_processed": 0,
    "notify_progress_every_n_processed": 0,
    "notify_progress_min_interval_seconds": 600,
    "notify_coordinator_progress_every_seconds": 600,
    "request_timeout_seconds": 30,
    "retry_attempts": 4,
    "retry_delay_seconds": 3,
    "force_ipv4": false,
    "notify_on_start": true,
    "notify_on_finish": true,
    "notify_on_error": true,
    "notify_on_ip_block": true,
    "notify_on_stall": true,
    "notify_on_heartbeat": false,
    "separator_before_worker_messages": false,
    "separator_text": "------------------------------",
    "separator_message_types": [
      "start",
      "downloaded",
      "skipped",
      "error",
      "api_error",
      "ip_blocked",
      "progress",
      "stall",
      "heartbeat",
      "finish",
      "finish_with_error"
    ]
  },
  "settings": {
    "test_mode": true,
    "test_limit": 50,
    "retry_attempts": 3,
    "retry_delay": 5,
    "javascript_wait_time": 15,
    "download_timeout": 600,
    "connect_timeout": 30,
    "download_chunk_size_kb": 1024,
    "download_progress_log_seconds": 15,
    "download_only_original": false,
    "store_full_api_payload_for_downloaded": true,
    "download_interface": "",
    "download_retry_interface": "",
    "direct_download_timeout_seconds": 600,
    "curl_stall_timeout_seconds": 600,
    "login_completion_timeout_seconds": 30,
    "login_retry_attempts": 3,
    "login_retry_delay_seconds": 10
  },
  "browser": {
    "uc": true,
    "headless": false,
    "xvfb": false,
    "disable_csp": true,
    "block_images": false,
    "incognito": false,
    "chromium_arg": "--disable-blink-features=AutomationControlled"
  },
  "runtime": {
    "job_name": "Vimeo Downloader",
    "worker_name": "worker-01",
    "worker_index": 1,
    "worker_count": 1,
    "vimeo_authenticated_session": false,
    "batch_number": 0,
    "batch_count": 0
  },
  "watchdog": {
    "enabled": true,
    "stall_alert_after_seconds": 1800,
    "repeat_alert_every_seconds": 1800,
    "heartbeat_every_seconds": 900
  },
  "resume": {
    "enabled": true,
    "state_file": "output/run/resume_state.json",
    "skip_completed_files": true,
    "resume_partial_downloads": true
  },
  "offload": {
    "enabled": false,
    "storage_root": "/absolute/path/to/mounted/storage/parse-1",
    "registry_file": "output/run/offload_registry.json",
    "log_file": "output/run/offload.log",
    "scan_interval_seconds": 600,
    "min_file_age_seconds": 30,
    "delete_local_video_after_upload": false,
    "validate_with_ffprobe": true,
    "ffprobe_bin": "ffprobe"
  },
  "workers": {
    "count": 2,
    "stagger_start_seconds": 3,
    "shared_media_dirs": false,
    "api_pool": [
      {
        "client_id": "WORKER_01_VIMEO_CLIENT_ID",
        "client_secret": "WORKER_01_VIMEO_CLIENT_SECRET",
        "token": "WORKER_01_VIMEO_TOKEN"
      },
      {
        "client_id": "WORKER_02_VIMEO_CLIENT_ID",
        "client_secret": "WORKER_02_VIMEO_CLIENT_SECRET",
        "token": "WORKER_02_VIMEO_TOKEN"
      }
    ]
  },
  "batches": {
    "enabled": true,
    "batch_size": 10000,
    "auto_advance": true,
    "reuse_existing_shards": true,
    "stop_on_batch_error": true,
    "max_batches": 0,
    "shards_dir": "data_shards/generated_batches",
    "runs_dir": "output/batches/runs",
    "state_file": "output/batches/batch_state.json",
    "manifest_file": "output/batches/batches_manifest.json",
    "global_results_file": "output/batches/global_results_manifest.json",
    "global_downloaded_file": "output/batches/global_downloaded_videos.json",
    "global_summary_file": "output/batches/global_summary.json"
  }
}
